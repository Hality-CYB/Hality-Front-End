# URL base da API do backend (Hality-Back-End)
NEXT_PUBLIC_API_URL=http://localhost:8000

# "enabled" intercepta chamadas de API com dados fake (MSW) — útil enquanto
# o backend não tem os endpoints reais prontos. Trocar para "disabled" para
# falar com o Hality-Back-End de verdade.
NEXT_PUBLIC_API_MOCKING=enabled

# Chave usada pra assinar/verificar o cookie de sessão (JWT). O valor
# abaixo é só pra dev local — nunca comitar/usar um AUTH_SECRET de verdade
# em .env.example ou em qualquer lugar versionado.
AUTH_SECRET=dev-secret-troque-em-producao-nao-versione
