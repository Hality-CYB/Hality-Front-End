# Variáveis do front (Next.js). Copie para `.env.local` (fora do git) e ajuste.
# Só valores de exemplo: nunca coloque credenciais reais aqui.

# URL base da API do back (Hality-Back-End). Local: docker compose do back.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock da API com MSW (dados falsos no navegador, sem back rodando).
# - enabled: liga o mock. Use só em desenvolvimento local sem back.
# - disabled (ou ausente): fala com o back em NEXT_PUBLIC_API_URL.
# CI, homologação e produção rodam sempre sem mock.
NEXT_PUBLIC_API_MOCKING=disabled

# Login com Google (OAuth) está integrado para pacientes. O front não tem
# variável própria: usa NEXT_PUBLIC_API_URL para apontar o botão a
# {NEXT_PUBLIC_API_URL}/api/v1/auth/google/authorize. O retorno cai em
# /login/google. Client id, segredo e redirect ficam só no back.

# Smoke contra o back real (`npm run smoke`, ver README). Usuários do seed do
# back; a senha vem de SEED_PASSWORD no .env do back.
# SMOKE_API_URL=http://localhost:8000
# SMOKE_SENHA=
# SMOKE_EMAIL_ADMIN=admin@hality.com
# SMOKE_EMAIL_PROFISSIONAL=ana.souza@hality.com
# SMOKE_EMAIL_PACIENTE=carla.mendes@example.com
